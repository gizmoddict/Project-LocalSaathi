// ==============================================================================
// LocalSaathi PostgreSQL + PostGIS Database Schema
// Production-grade Hyperlocal Employment Platform
// ==============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, uuidOssp(map: "uuid-ossp")]
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum UserRole {
  WORKER
  EMPLOYER
  ADMIN
  MODERATOR
  SUPPORT
}

enum AccountStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  DELETED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum WageType {
  HOURLY
  DAILY
  FIXED
  PIECE_RATE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  PAUSED
  FILLED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum JobUrgency {
  IMMEDIATE
  STANDARD
  FLEXIBLE
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  BOOKED
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum BookingStatus {
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum ConversationType {
  DIRECT
  JOB_CONTEXT
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  SYSTEM
}

enum PaymentStatus {
  INITIATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  DISPUTED
}

enum VerificationType {
  AADHAAR
  PAN
  DRIVING_LICENSE
  VOTER_ID
  PASSPORT
}

enum DocumentType {
  GOVERNMENT_ID
  TRADE_CERTIFICATE
  PROFILE_IMAGE
  WORK_SAMPLE
}

enum ReportTargetType {
  USER
  JOB
  MESSAGE
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum DisputeStatus {
  OPEN
  UNDER_INVESTIGATION
  RESOLVED
  CLOSED
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum SearchIndexEntityType {
  JOB
  WORKER
}

enum SearchIndexOperation {
  INDEX
  UPDATE
  DELETE
}

enum SearchIndexStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ------------------------------------------------------------------------------
// 1. USERS
// ------------------------------------------------------------------------------

model User {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone              String             @unique @db.VarChar(20)
  email              String?            @unique @db.VarChar(255)
  role               UserRole           @default(WORKER)
  accountStatus      AccountStatus      @default(ACTIVE) @map("account_status")
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")

  // Relationships
  workerProfile         WorkerProfile?
  employerProfile       EmployerProfile?
  conversationMembers   ConversationMember[]
  sentMessages          Message[]
  notifications         Notification[]
  payerPayments         Payment[]              @relation("PayerPayments")
  payeePayments         Payment[]              @relation("PayeePayments")
  identityVerifications IdentityVerification[]
  documents             Document[]
  reportsFiled          Report[]               @relation("ReporterUser")
  auditLogs             AuditLog[]
  sessions              Session[]
  userDevices           UserDevice[]
  reviewsGiven          Rating[]               @relation("ReviewerRatings")
  reviewsReceived       Rating[]               @relation("ReviewedUserRatings")
  disputesRaised        Dispute[]              @relation("DisputeRaisedBy")
  disputesAgainst       Dispute[]              @relation("DisputeAgainst")

  @@index([role, accountStatus])
  @@index([createdAt(sort: Desc)])
  @@map("users")
}

// ------------------------------------------------------------------------------
// 2. WORKER PROFILES
// ------------------------------------------------------------------------------

model WorkerProfile {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  displayName        String    @map("display_name") @db.VarChar(100)
  profilePhotoKey    String?   @map("profile_photo_key") @db.VarChar(255)
  bio                String?   @db.Text
  experienceYears    Int       @default(0) @map("experience_years")
  expectedWage       Decimal?  @map("expected_wage") @db.Decimal(12, 2)
  wageType           WageType  @default(DAILY) @map("wage_type")
  preferredRadiusKm  Int       @default(10) @map("preferred_radius_km")
  languages          String[]  @default(["en", "hi"])
  isAvailable        Boolean   @default(true) @map("is_available")
  completedJobsCount Int       @default(0) @map("completed_jobs_count")
  avgRating          Decimal   @default(0.0) @map("avg_rating") @db.Decimal(3, 2)
  ratingCount        Int       @default(0) @map("rating_count")
  reliabilityScore   Decimal   @default(100.0) @map("reliability_score") @db.Decimal(5, 2)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  // Relationships
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workerSkills    WorkerSkill[]
  workerLocation  WorkerLocation?
  availabilities  Availability[]
  jobApplications JobApplication[]
  bookings        Booking[]

  @@index([isAvailable, avgRating(sort: Desc)])
  @@index([expectedWage])
  @@map("worker_profiles")
}

// ------------------------------------------------------------------------------
// 3. EMPLOYER PROFILES
// ------------------------------------------------------------------------------

model EmployerProfile {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  businessName       String             @map("business_name") @db.VarChar(150)
  description        String?            @db.Text
  businessType       String?            @map("business_type") @db.VarChar(50)
  contactPreferences String[]           @default(["PHONE", "IN_APP"]) @map("contact_preferences")
  verificationState  VerificationStatus @default(UNVERIFIED) @map("verification_state")
  totalJobsPosted    Int                @default(0) @map("total_jobs_posted")
  totalHires         Int                @default(0) @map("total_hires")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")

  // Relationships
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosts JobPost[]
  bookings Booking[]

  @@index([businessName])
  @@map("employer_profiles")
}

// ------------------------------------------------------------------------------
// 4. SKILLS
// ------------------------------------------------------------------------------

model Skill {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String   @db.VarChar(100)
  normalizedName String   @unique @map("normalized_name") @db.VarChar(100)
  category       String   @db.VarChar(50)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relationships
  workerSkills      WorkerSkill[]
  jobRequiredSkills JobRequiredSkill[]

  @@index([category, isActive])
  @@map("skills")
}

// ------------------------------------------------------------------------------
// 5. WORKER SKILLS
// ------------------------------------------------------------------------------

model WorkerSkill {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workerProfileId String   @map("worker_profile_id") @db.Uuid
  skillId         String   @map("skill_id") @db.Uuid
  proficiency     String   @default("INTERMEDIATE") @db.VarChar(20)
  experienceYears Int      @default(1) @map("experience_years")
  isVerified      Boolean  @default(false) @map("is_verified")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relationships
  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  skill         Skill         @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([workerProfileId, skillId])
  @@index([skillId, isVerified])
  @@map("worker_skills")
}

// ------------------------------------------------------------------------------
// 6. JOB POSTS
// ------------------------------------------------------------------------------

model JobPost {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employerProfileId    String     @map("employer_profile_id") @db.Uuid
  title                String     @db.VarChar(200)
  description          String     @db.Text
  status               JobStatus  @default(DRAFT)
  category             String     @db.VarChar(50)
  wageType             WageType   @map("wage_type")
  wageAmount           Decimal    @map("wage_amount") @db.Decimal(12, 2)
  workerCount          Int        @default(1) @map("worker_count")
  durationDays         Int        @default(1) @map("duration_days")
  startDate            DateTime   @map("start_date") @db.Date
  startTime            String?    @map("start_time") @db.VarChar(10)
  urgency              JobUrgency @default(STANDARD)
  requirements         String[]   @default([])
  languageRequirements String[]   @default([]) @map("language_requirements")
  publishedAt          DateTime?  @map("published_at")
  expiresAt            DateTime?  @map("expires_at")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")
  deletedAt            DateTime?  @map("deleted_at")

  // Relationships
  employerProfile   EmployerProfile    @relation(fields: [employerProfileId], references: [id], onDelete: Cascade)
  jobRequiredSkills JobRequiredSkill[]
  jobLocation       JobLocation?
  jobApplications   JobApplication[]
  bookings          Booking[]
  conversations     Conversation[]

  @@index([status, category, publishedAt(sort: Desc)])
  @@index([employerProfileId, status])
  @@index([startDate(sort: Asc)])
  @@map("job_posts")
}

// ------------------------------------------------------------------------------
// 7. JOB REQUIRED SKILLS
// ------------------------------------------------------------------------------

model JobRequiredSkill {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobPostId          String   @map("job_post_id") @db.Uuid
  skillId            String   @map("skill_id") @db.Uuid
  isRequired         Boolean  @default(true) @map("is_required")
  minExperienceYears Int      @default(0) @map("min_experience_years")
  createdAt          DateTime @default(now()) @map("created_at")

  // Relationships
  jobPost JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([jobPostId, skillId])
  @@index([skillId, isRequired])
  @@map("job_required_skills")
}

// ------------------------------------------------------------------------------
// 8. JOB LOCATIONS (PostGIS Point)
// ------------------------------------------------------------------------------

model JobLocation {
  id          String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobPostId   String                                @unique @map("job_post_id") @db.Uuid
  latitude    Float
  longitude   Float
  location    Unsupported("geography(Point, 4326)")?
  addressLine String?                               @map("address_line") @db.VarChar(255)
  locality    String                                @db.VarChar(100)
  city        String                                @db.VarChar(100)
  state       String                                @db.VarChar(100)
  pinCode     String                                @map("pin_code") @db.VarChar(10)
  createdAt   DateTime                              @default(now()) @map("created_at")
  updatedAt   DateTime                              @updatedAt @map("updated_at")

  // Relationships
  jobPost JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@index([city, locality])
  @@map("job_locations")
}

// ------------------------------------------------------------------------------
// 9. WORKER LOCATIONS (PostGIS Point - Retention Friendly)
// ------------------------------------------------------------------------------

model WorkerLocation {
  id              String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workerProfileId String                                @unique @map("worker_profile_id") @db.Uuid
  latitude        Float
  longitude       Float
  location        Unsupported("geography(Point, 4326)")?
  accuracyMeters  Float?                                @map("accuracy_meters")
  isActive        Boolean                               @default(true) @map("is_active")
  updatedAt       DateTime                              @updatedAt @map("updated_at")

  // Relationships
  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@index([isActive, updatedAt(sort: Desc)])
  @@map("worker_locations")
}

// ------------------------------------------------------------------------------
// 10. AVAILABILITY
// ------------------------------------------------------------------------------

model Availability {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workerProfileId String             @map("worker_profile_id") @db.Uuid
  date            DateTime           @db.Date
  startTime       String?            @map("start_time") @db.VarChar(10)
  endTime         String?            @map("end_time") @db.VarChar(10)
  status          AvailabilityStatus @default(AVAILABLE)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  // Relationships
  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@unique([workerProfileId, date])
  @@index([workerProfileId, date, status])
  @@map("availability")
}

// ------------------------------------------------------------------------------
// 11. JOB APPLICATIONS
// ------------------------------------------------------------------------------

model JobApplication {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobPostId       String            @map("job_post_id") @db.Uuid
  workerProfileId String            @map("worker_profile_id") @db.Uuid
  status          ApplicationStatus @default(APPLIED)
  decisionNotes   String?           @map("decision_notes") @db.Text
  appliedAt       DateTime          @default(now()) @map("applied_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  // Relationships
  jobPost       JobPost       @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  booking       Booking?

  // Constraint: One active application per worker per job
  @@unique([jobPostId, workerProfileId])
  @@index([jobPostId, status])
  @@index([workerProfileId, status])
  @@map("job_applications")
}

// ------------------------------------------------------------------------------
// 12. BOOKINGS
// ------------------------------------------------------------------------------

model Booking {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobPostId         String        @map("job_post_id") @db.Uuid
  applicationId     String        @unique @map("application_id") @db.Uuid
  employerProfileId String        @map("employer_profile_id") @db.Uuid
  workerProfileId   String        @map("worker_profile_id") @db.Uuid
  scheduledStart    DateTime      @map("scheduled_start")
  scheduledEnd      DateTime      @map("scheduled_end")
  status            BookingStatus @default(CONFIRMED)
  totalAmount       Decimal       @map("total_amount") @db.Decimal(12, 2)
  currency          String        @default("INR") @db.VarChar(10)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  // Relationships
  jobPost         JobPost         @relation(fields: [jobPostId], references: [id], onDelete: Restrict)
  application     JobApplication  @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  employerProfile EmployerProfile @relation(fields: [employerProfileId], references: [id], onDelete: Restrict)
  workerProfile   WorkerProfile   @relation(fields: [workerProfileId], references: [id], onDelete: Restrict)
  payments        Payment[]
  ratings         Rating[]
  disputes        Dispute[]

  @@index([employerProfileId, status])
  @@index([workerProfileId, status])
  @@index([scheduledStart(sort: Asc)])
  @@map("bookings")
}

// ------------------------------------------------------------------------------
// 13. CONVERSATIONS
// ------------------------------------------------------------------------------

model Conversation {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      ConversationType @default(JOB_CONTEXT)
  jobPostId String?          @map("job_post_id") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  // Relationships
  jobPost JobPost?             @relation(fields: [jobPostId], references: [id], onDelete: SetNull)
  members ConversationMember[]
  messages Message[]

  @@index([jobPostId])
  @@map("conversations")
}

// ------------------------------------------------------------------------------
// 14. CONVERSATION MEMBERS
// ------------------------------------------------------------------------------

model ConversationMember {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  joinedAt       DateTime  @default(now()) @map("joined_at")
  lastReadAt     DateTime? @map("last_read_at")

  // Relationships
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, joinedAt(sort: Desc)])
  @@map("conversation_members")
}

// ------------------------------------------------------------------------------
// 15. MESSAGES
// ------------------------------------------------------------------------------

model Message {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  senderId       String      @map("sender_id") @db.Uuid
  messageType    MessageType @default(TEXT) @map("message_type")
  content        String?     @db.Text
  attachmentKey  String?     @map("attachment_key") @db.VarChar(255)
  sentAt         DateTime    @default(now()) @map("sent_at")
  editedAt       DateTime?   @map("edited_at")
  deletedAt      DateTime?   @map("deleted_at")

  // Relationships
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId, sentAt(sort: Desc)])
  @@map("messages")
}

// ------------------------------------------------------------------------------
// 16. NOTIFICATIONS
// ------------------------------------------------------------------------------

model Notification {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid
  type        String    @db.VarChar(50)
  title       String    @db.VarChar(150)
  body        String    @db.Text
  payload     Json?
  isRead      Boolean   @default(false) @map("is_read")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relationships
  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

// ------------------------------------------------------------------------------
// 17. RATINGS / REVIEWS
// ------------------------------------------------------------------------------

model Rating {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewerId     String   @map("reviewer_id") @db.Uuid
  reviewedUserId String   @map("reviewed_user_id") @db.Uuid
  bookingId      String   @map("booking_id") @db.Uuid
  rating         Int      @db.SmallInt
  review         String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  // Relationships
  reviewer     User    @relation("ReviewerRatings", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewedUser User    @relation("ReviewedUserRatings", fields: [reviewedUserId], references: [id], onDelete: Restrict)
  booking      Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@unique([bookingId, reviewerId])
  @@index([reviewedUserId, rating])
  @@map("ratings")
}

// ------------------------------------------------------------------------------
// 18. PAYMENTS
// ------------------------------------------------------------------------------

model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payerId           String        @map("payer_id") @db.Uuid
  payeeId           String?       @map("payee_id") @db.Uuid
  bookingId         String?       @map("booking_id") @db.Uuid
  provider          String        @default("RAZORPAY") @db.VarChar(50)
  providerPaymentId String?       @unique @map("provider_payment_id") @db.VarChar(100)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR") @db.VarChar(10)
  status            PaymentStatus @default(INITIATED)
  idempotencyKey    String        @unique @map("idempotency_key") @db.VarChar(100)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  // Relationships
  payer   User     @relation("PayerPayments", fields: [payerId], references: [id], onDelete: Restrict)
  payee   User?    @relation("PayeePayments", fields: [payeeId], references: [id], onDelete: SetNull)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([payerId, status])
  @@index([payeeId, status])
  @@index([createdAt(sort: Desc)])
  @@map("payments")
}

// ------------------------------------------------------------------------------
// 19. PAYMENT EVENTS (Webhooks & Replay Protection)
// ------------------------------------------------------------------------------

model PaymentEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    String    @default("RAZORPAY") @db.VarChar(50)
  eventId     String    @unique @map("event_id") @db.VarChar(150)
  eventType   String    @map("event_type") @db.VarChar(100)
  payload     Json
  isProcessed Boolean   @default(false) @map("is_processed")
  processedAt DateTime? @map("processed_at")
  receivedAt  DateTime  @default(now()) @map("received_at")

  @@index([provider, eventType])
  @@index([isProcessed, receivedAt(sort: Asc)])
  @@map("payment_events")
}

// ------------------------------------------------------------------------------
// 20. IDENTITY VERIFICATIONS
// ------------------------------------------------------------------------------

model IdentityVerification {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  verificationType  VerificationType   @map("verification_type")
  status            VerificationStatus @default(PENDING)
  providerReference String?            @map("provider_reference") @db.VarChar(100)
  verifiedAt        DateTime?          @map("verified_at")
  rejectionReason   String?            @map("rejection_reason") @db.Text
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("identity_verifications")
}

// ------------------------------------------------------------------------------
// 21. DOCUMENTS (Metadata Only)
// ------------------------------------------------------------------------------

model Document {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId            String             @map("owner_id") @db.Uuid
  type               DocumentType
  objectStorageKey   String             @map("object_storage_key") @db.VarChar(255)
  mimeType           String             @map("mime_type") @db.VarChar(100)
  fileSizeBytes      Int                @map("file_size_bytes")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  createdAt          DateTime           @default(now()) @map("created_at")
  deletedAt          DateTime?          @map("deleted_at")

  // Relationships
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, type])
  @@map("documents")
}

// ------------------------------------------------------------------------------
// 22. REPORTS
// ------------------------------------------------------------------------------

model Report {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId String           @map("reporter_id") @db.Uuid
  targetType ReportTargetType @map("target_type")
  targetId   String           @map("target_id") @db.Uuid
  reason     String           @db.Text
  status     ReportStatus     @default(PENDING)
  createdAt  DateTime         @default(now()) @map("created_at")
  resolvedAt DateTime?        @map("resolved_at")

  // Relationships
  reporter User @relation("ReporterUser", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([status, createdAt(sort: Asc)])
  @@map("reports")
}

// ------------------------------------------------------------------------------
// 23. DISPUTES
// ------------------------------------------------------------------------------

model Dispute {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId   String        @map("booking_id") @db.Uuid
  raisedById  String        @map("raised_by_id") @db.Uuid
  againstId   String        @map("against_id") @db.Uuid
  reason      String        @db.Text
  status      DisputeStatus @default(OPEN)
  resolution  String?       @db.Text
  createdAt   DateTime      @default(now()) @map("created_at")
  resolvedAt  DateTime?     @map("resolved_at")

  // Relationships
  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  raisedBy User    @relation("DisputeRaisedBy", fields: [raisedById], references: [id], onDelete: Restrict)
  against  User    @relation("DisputeAgainst", fields: [againstId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([status, createdAt(sort: Asc)])
  @@map("disputes")
}

// ------------------------------------------------------------------------------
// 24. AUDIT LOGS (Immutable)
// ------------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.VarChar(100)
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  // Relationships
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ------------------------------------------------------------------------------
// 25. SESSIONS
// ------------------------------------------------------------------------------

model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  sessionTokenHash String    @unique @map("session_token_hash") @db.VarChar(128)
  deviceInfo       String?   @map("device_info") @db.VarChar(255)
  createdAt        DateTime  @default(now()) @map("created_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

// ------------------------------------------------------------------------------
// 26. USER DEVICES
// ------------------------------------------------------------------------------

model UserDevice {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  deviceId      String         @map("device_id") @db.VarChar(100)
  platform      DevicePlatform @default(ANDROID)
  pushTokenHash String?        @map("push_token_hash") @db.VarChar(128)
  lastSeenAt    DateTime       @default(now()) @map("last_seen_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, platform])
  @@map("user_devices")
}

// ------------------------------------------------------------------------------
// 27. SEARCH INDEX EVENTS (Asynchronous OpenSearch Queue)
// ------------------------------------------------------------------------------

model SearchIndexEvent {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType   SearchIndexEntityType @map("entity_type")
  entityId     String                @map("entity_id") @db.Uuid
  operation    SearchIndexOperation
  status       SearchIndexStatus     @default(PENDING)
  retryCount   Int                   @default(0) @map("retry_count")
  availableAt  DateTime              @default(now()) @map("available_at")
  processedAt  DateTime?             @map("processed_at")
  errorDetails String?               @map("error_details") @db.Text
  createdAt    DateTime              @default(now()) @map("created_at")

  @@index([status, availableAt(sort: Asc)])
  @@index([entityType, entityId])
  @@map("search_index_events")
}
