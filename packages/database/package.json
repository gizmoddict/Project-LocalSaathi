{
  "name": "@localsaathi/database",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL + PostGIS database layer for LocalSaathi (Prisma ORM)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "ts-node prisma/seed.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"@localsaathi/database lint passed\"",
    "test": "jest --passWithNoTests",
    "test:integration": "jest --config jest.config.js test/database.integration.spec.ts",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@localsaathi/types": "*",
    "@localsaathi/validation": "*",
    "@nestjs/common": "^10.4.15",
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@localsaathi/config": "*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
