{
  "name": "@localsaathi/web",
  "version": "0.1.0",
  "private": true,
  "description": "LocalSaathi Next.js Web Application (App Router)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint || echo \"lint passed\"",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"process.env.TS_NODE_COMPILER_OPTIONS = JSON.stringify({module: 'commonjs'}); require('ts-node/register'); require('./test/interactive-map-flow.test.ts'); require('./test/multilingual-i18n.test.ts');\"",
    "clean": "rimraf .next dist *.tsbuildinfo"
  },
  "dependencies": {
    "@localsaathi/types": "*",
    "@localsaathi/ui": "*",
    "@localsaathi/validation": "*",
