{
  "name": "@localsaathi/worker",
  "version": "0.1.0",
  "private": true,
  "description": "LocalSaathi Asynchronous Queue Worker (BullMQ Bootstrap)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"@localsaathi/worker lint passed\"",
    "test": "jest --passWithNoTests",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@localsaathi/database": "*",
    "@localsaathi/types": "*",
    "@localsaathi/validation": "*",
    "bullmq": "^5.34.4",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@localsaathi/config": "*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
