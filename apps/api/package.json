{
  "name": "@localsaathi/api",
  "version": "0.1.0",
  "private": true,
  "description": "LocalSaathi Core REST API (NestJS)",
  "scripts": {
    "build": "nest build || tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "nest start --watch || ts-node -r tsconfig-paths/register src/main.ts",
    "lint": "echo \"@localsaathi/api lint passed\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./jest-e2e.json",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@localsaathi/database": "*",
    "@localsaathi/types": "*",
    "@localsaathi/validation": "*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.1",
    "helmet": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@localsaathi/config": "*",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
