{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 1,
    "analysis": {
      "analyzer": {
        "autocomplete_analyzer": {
          "type": "custom",
          "tokenizer": "autocomplete_tokenizer",
          "filter": ["lowercase"]
        }
      },
      "tokenizer": {
        "autocomplete_tokenizer": {
          "type": "edge_ngram",
          "min_gram": 2,
          "max_gram": 15,
          "token_chars": ["letter", "digit"]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "id": { "type": "keyword" },
      "employerProfileId": { "type": "keyword" },
      "title": {
        "type": "text",
        "fields": {
          "keyword": { "type": "keyword" },
          "autocomplete": {
            "type": "text",
            "analyzer": "autocomplete_analyzer",
            "search_analyzer": "standard"
          }
        }
      },
      "description": { "type": "text" },
      "category": { "type": "keyword" },
      "status": { "type": "keyword" },
      "wageAmount": { "type": "double" },
      "wageType": { "type": "keyword" },
      "workerCount": { "type": "integer" },
      "durationDays": { "type": "integer" },
      "startDate": { "type": "date" },
      "startTime": { "type": "keyword" },
      "urgency": { "type": "keyword" },
      "requirements": { "type": "text" },
      "location": { "type": "geo_point" },
      "locality": {
        "type": "text",
        "fields": {
          "keyword": { "type": "keyword" }
        }
      },
      "city": { "type": "keyword" },
      "state": { "type": "keyword" },
      "pinCode": { "type": "keyword" },
      "requiredSkillIds": { "type": "keyword" },
      "publishedAt": { "type": "date" },
      "createdAt": { "type": "date" },
      "updatedAt": { "type": "date" }
    }
  }
}
