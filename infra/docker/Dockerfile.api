# ==============================================================================
# LocalSaathi NestJS API Multi-Stage Production Dockerfile
# Hardened, Non-Root, Minimal Runtime, Graceful SIGTERM via dumb-init
# ==============================================================================

# --- Stage 1: Build & Compile ---
FROM node:22-alpine AS builder

WORKDIR /app

# Install build dependencies & OpenSSL for Prisma engine compilation
RUN apk add --no-cache libc6-compat openssl

# Copy root configurations and package manifests
COPY package.json package-lock.json turbo.json tsconfig.json ./
COPY apps/api/package.json ./apps/api/package.json
COPY packages/config/package.json ./packages/config/package.json
COPY packages/types/package.json ./packages/types/package.json
COPY packages/validation/package.json ./packages/validation/package.json
COPY packages/database/package.json ./packages/database/package.json
COPY packages/ui/package.json ./packages/ui/package.json

# Install dependencies deterministically
RUN npm ci

# Copy source code across dependent workspaces
COPY apps/api ./apps/api
COPY packages/config ./packages/config
COPY packages/types ./packages/types
COPY packages/validation ./packages/validation
COPY packages/database ./packages/database
COPY packages/ui ./packages/ui

# Generate Prisma Client
RUN npx prisma generate --schema=./packages/database/prisma/schema.prisma

# Build all API dependencies and the NestJS application
RUN npx turbo run build --filter=@localsaathi/api...

# --- Stage 2: Production Runtime ---
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV API_PORT=4000

# Install dumb-init for proper PID 1 signal forwarding & OpenSSL for Prisma runtime
RUN apk add --no-cache dumb-init openssl

# Create non-root system user and group
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nestjs

# Copy built package artifacts and dependencies from builder
COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/api ./apps/api

# Enforce non-root execution
USER nestjs

EXPOSE 4000

# Health check against liveness endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:4000/api/v1/health/live || exit 1

# Graceful termination handling via dumb-init
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "apps/api/dist/main.js"]
