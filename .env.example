# ==============================================================================
# LocalSaathi Environment Configuration Template (.env.example)
# DO NOT COMMIT SENSITIVE VALUES OR PRODUCTION SECRETS TO VERSION CONTROL
# ==============================================================================

# --- Node & Application Ports ---
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
WORKER_PORT=4001
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# --- Centralized Logging & Telemetry ---
LOG_LEVEL=debug
ENABLE_REQUEST_LOGGING=true

# --- Security & CORS ---
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# --- Primary Database (PostgreSQL + PostGIS) ---
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]?sslmode=prefer
DATABASE_URL=postgresql://localsaathi_admin:localsaathi_dev_password@localhost:5432/localsaathi_db?schema=public
DB_HOST=localhost
DB_PORT=5432
DB_USER=localsaathi_admin
DB_PASSWORD=localsaathi_dev_password
DB_NAME=localsaathi_db

# --- Distributed Cache & Queue (Redis) ---
# Format: redis://[default:[password]@]host:port[/db]
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Map & Geocoding Provider Configuration ---
# Tile server URL template (Leaflet compatible). Default uses OpenStreetMap standard tiles.
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# Geocoding provider: nominatim (default) or custom
NEXT_PUBLIC_GEOCODING_PROVIDER=nominatim
NEXT_PUBLIC_GEOCODING_BASE_URL=
NEXT_PUBLIC_GEOCODING_API_KEY=

# --- Search Subsystem (OpenSearch) ---
# Format: http(s)://host:port
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin

# --- Authentication & JWT Secrets ---
JWT_ACCESS_SECRET=replace_with_secure_random_base64_string_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_secure_random_base64_string_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
AUTH_PEPPER=replace_with_secure_auth_pepper_secret_minimum_32_characters
AUTH_COOKIE_NAME=localsaathi_refresh_token

# --- OTP Configuration ---
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
RATE_LIMIT_OTP_REQUESTS=5
RATE_LIMIT_OTP_VERIFY=5
SMS_PROVIDER=development
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=


# --- Payment Gateway (Razorpay - Phase 15 placeholders) ---
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# --- AI & Vector Embeddings (Phase 8 placeholders) ---
OPENAI_API_KEY=sk-placeholder_openai_or_compatible_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
AI_EMBEDDING_MODEL=text-embedding-3-small

# --- Object Storage (Cloud Storage / S3 / MinIO - placeholders) ---
STORAGE_PROVIDER=local
STORAGE_BUCKET=localsaathi-media
STORAGE_ACCESS_KEY=placeholder_access_key
STORAGE_SECRET_KEY=placeholder_secret_key
STORAGE_REGION=ap-south-1
STORAGE_ENDPOINT=http://localhost:9000

# --- SMS & OTP Dispatcher (Phase 3/13 placeholders) ---
SMS_API_KEY=placeholder_sms_api_key
SMS_SENDER_ID=LCSATH

# --- Reliability & Resilience (Phase 22) ---
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_MS=250
RETRY_MAX_DELAY_MS=5000
RETRY_JITTER_PERCENT=0.20
DB_OPERATION_TIMEOUT_MS=5000
REDIS_OPERATION_TIMEOUT_MS=1500
EXTERNAL_HTTP_TIMEOUT_MS=10000
PAYMENT_PROVIDER_TIMEOUT_MS=10000
NOTIFICATION_PROVIDER_TIMEOUT_MS=8000
CB_FAILURE_THRESHOLD=5
CB_ROLLING_WINDOW_MS=10000
CB_OPEN_DURATION_MS=15000
CB_HALF_OPEN_PROBES=3
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000

# --- Disaster Recovery & Data Integrity (Phase 23) ---
BACKUP_STORAGE_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=
ISOLATED_RESTORE_DB_URL=postgresql://postgres:postgres@localhost:5432/localsaathi_restore?schema=public
