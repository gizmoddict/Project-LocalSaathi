# ==============================================================================
# LocalSaathi Staging Environment Configuration (.env.staging.example)
# Staging mirrors production architecture with sandbox / test credentials
# ==============================================================================

NODE_ENV=production
APP_ENV=staging
API_PORT=4000
WEB_PORT=3000
WORKER_PORT=4001
API_URL=https://staging-api.localsaathi.com
WEB_URL=https://staging.localsaathi.com

# --- Logging & Telemetry ---
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

# --- Security & CORS ---
CORS_ALLOWED_ORIGINS=https://staging.localsaathi.com
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=200

# --- Primary Database (Staging Isolated PostgreSQL + PostGIS) ---
DATABASE_URL=postgresql://staging_user:staging_secure_password_replace@staging-db.internal:5432/localsaathi_staging?sslmode=require&schema=public
DB_HOST=staging-db.internal
DB_PORT=5432
DB_USER=staging_user
DB_PASSWORD=staging_secure_password_replace
DB_NAME=localsaathi_staging

# --- Distributed Cache & Queue (Staging Isolated Redis) ---
REDIS_URL=rediss://:staging_redis_password_replace@staging-redis.internal:6379/0
REDIS_HOST=staging-redis.internal
REDIS_PORT=6379
REDIS_PASSWORD=staging_redis_password_replace

# --- Search Subsystem (Staging OpenSearch) ---
OPENSEARCH_URL=https://staging-search.internal:9200
OPENSEARCH_USERNAME=staging_search_user
OPENSEARCH_PASSWORD=staging_search_password_replace

# --- Authentication & JWT Secrets (Unique to Staging) ---
JWT_ACCESS_SECRET=staging_jwt_access_secret_min_32_characters_random_hex_value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=staging_jwt_refresh_secret_min_32_characters_random_hex_value
JWT_REFRESH_EXPIRES_IN=7d
JWT_PREVIOUS_ACCESS_SECRET=
AUTH_PEPPER=staging_auth_pepper_min_32_characters_random_hex_value
AUTH_COOKIE_NAME=localsaathi_staging_refresh_token

# --- OTP Configuration ---
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
RATE_LIMIT_OTP_REQUESTS=10
RATE_LIMIT_OTP_VERIFY=10
SMS_PROVIDER=mock

# --- Payment Gateway (Razorpay Sandbox Credentials) ---
RAZORPAY_KEY_ID=rzp_test_staging_placeholder_key
RAZORPAY_KEY_SECRET=staging_razorpay_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=staging_webhook_secret_placeholder
RAZORPAY_PREVIOUS_WEBHOOK_SECRET=

# --- Object Storage (Staging S3/GCS Bucket) ---
STORAGE_PROVIDER=s3
STORAGE_BUCKET=localsaathi-staging-media
STORAGE_ACCESS_KEY=staging_storage_access_key
STORAGE_SECRET_KEY=staging_storage_secret_key
STORAGE_REGION=ap-south-1

# --- Resilience & DR ---
BACKUP_STORAGE_DIR=/var/backups/localsaathi
BACKUP_RETENTION_DAYS=14
BACKUP_ENCRYPTION_KEY=staging_backup_encryption_key_32c_hex
ISOLATED_RESTORE_DB_URL=postgresql://staging_user:staging_secure_password_replace@staging-db.internal:5432/localsaathi_staging_restore?schema=public
