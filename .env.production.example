# ==============================================================================
# LocalSaathi Production Environment Configuration (.env.production.example)
# PRODUCTION SECRETS MUST NEVER BE COMMITTED. INJECT VIA CLOUD SECRET MANAGER.
# ==============================================================================

NODE_ENV=production
APP_ENV=production
API_PORT=4000
WEB_PORT=3000
WORKER_PORT=4001
API_URL=https://api.localsaathi.com
WEB_URL=https://localsaathi.com

# --- Logging & Telemetry ---
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

# --- Security & CORS (Strict: No Wildcards, HTTPS Only) ---
CORS_ALLOWED_ORIGINS=https://localsaathi.com,https://admin.localsaathi.com
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=300

# --- Primary Database (Production AWS RDS / Cloud SQL PostgreSQL + PostGIS) ---
# Enforce SSL/TLS: sslmode=verify-full with managed CA bundle
DATABASE_URL=postgresql://app_user:PROD_DB_PASSWORD_FROM_SECRETS_MANAGER@prod-db-primary.internal:5432/localsaathi_prod?sslmode=verify-full&sslrootcert=/etc/ssl/certs/rds-combined-ca-bundle.pem&schema=public
DB_HOST=prod-db-primary.internal
DB_PORT=5432
DB_USER=app_user
DB_PASSWORD=PROD_DB_PASSWORD_FROM_SECRETS_MANAGER
DB_NAME=localsaathi_prod

# --- Distributed Cache & Queue (Production Redis Cluster) ---
REDIS_URL=rediss://:PROD_REDIS_PASSWORD_FROM_SECRETS_MANAGER@prod-redis.internal:6379/0
REDIS_HOST=prod-redis.internal
REDIS_PORT=6379
REDIS_PASSWORD=PROD_REDIS_PASSWORD_FROM_SECRETS_MANAGER

# --- Search Subsystem (Production OpenSearch Cluster) ---
OPENSEARCH_URL=https://prod-search.internal:9200
OPENSEARCH_USERNAME=prod_search_user
OPENSEARCH_PASSWORD=PROD_SEARCH_PASSWORD_FROM_SECRETS_MANAGER

# --- Authentication & JWT Secrets (Dual-Key Rotation Support) ---
JWT_ACCESS_SECRET=PROD_JWT_ACCESS_SECRET_MIN_32_BYTES_HEX_ENTROPY
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=PROD_JWT_REFRESH_SECRET_MIN_32_BYTES_HEX_ENTROPY
JWT_REFRESH_EXPIRES_IN=7d
JWT_PREVIOUS_ACCESS_SECRET=OPTIONAL_PREVIOUS_KEY_DURING_ROTATION
AUTH_PEPPER=PROD_AUTH_PEPPER_MIN_32_BYTES_HEX_ENTROPY
AUTH_COOKIE_NAME=localsaathi_session_token

# --- OTP & SMS Gateway (Live Production Provider) ---
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
RATE_LIMIT_OTP_REQUESTS=5
RATE_LIMIT_OTP_VERIFY=5
SMS_PROVIDER=msg91
SMS_API_KEY=PROD_SMS_GATEWAY_API_KEY_FROM_SECRETS_MANAGER
SMS_SENDER_ID=LCSATH

# --- Payment Gateway (Live Razorpay Merchant Credentials) ---
# NEVER use rzp_test_* in production
RAZORPAY_KEY_ID=rzp_live_PROD_MERCHANT_KEY_ID
RAZORPAY_KEY_SECRET=PROD_RAZORPAY_MERCHANT_SECRET_FROM_SECRETS_MANAGER
RAZORPAY_WEBHOOK_SECRET=PROD_WEBHOOK_SECRET_FROM_SECRETS_MANAGER
RAZORPAY_PREVIOUS_WEBHOOK_SECRET=OPTIONAL_PREVIOUS_WEBHOOK_SECRET_DURING_ROTATION

# --- Object Storage (Encrypted S3 Bucket with Signed URLs) ---
STORAGE_PROVIDER=s3
STORAGE_BUCKET=localsaathi-prod-private-media
STORAGE_ACCESS_KEY=PROD_S3_IAM_ACCESS_KEY
STORAGE_SECRET_KEY=PROD_S3_IAM_SECRET_KEY
STORAGE_REGION=ap-south-1

# --- Disaster Recovery & Backup Encryption ---
BACKUP_STORAGE_DIR=/var/backups/localsaathi
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=PROD_BACKUP_AES256_ENCRYPTION_KEY_FROM_SECRETS_MANAGER
ISOLATED_RESTORE_DB_URL=postgresql://dr_admin:PROD_DR_PASSWORD@prod-db-drill.internal:5432/localsaathi_isolated_drill?schema=public
